rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isGlobalAdmin() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/globalAdmins/$(request.auth.uid));
    }

    function isAppAdmin(appId) {
      return isGlobalAdmin() || (
        request.auth != null &&
        exists(/databases/$(database)/documents/artifacts/$(appId)/public/data/users/$(request.auth.uid))
      );
    }
    
    function isIncrement(field) {
      return request.resource.data[field] == resource.data[field] + 1;
    }

    // Global Config
    match /global/config {
      allow read: if true;
      allow write: if isGlobalAdmin();
    }

    // Global Stats (Champions)
    match /global/stats {
      allow read: if true;
      allow create: if true; // Allow creating if not exists
      allow update: if isGlobalAdmin() || (
        // Allow updating stats fields (simplified check)
        request.resource.data.diff(resource.data).affectedKeys().hasAny(['championsCount', 'count_bronze', 'count_silver', 'count_gold', 'count_diamond'])
      );
    }

    // Artifacts (App Data)
    match /artifacts/{appId}/public/data {
      
      // Users (Admins)
      match /users/{userId} {
        allow read: if request.auth != null &&
          (request.auth.uid == userId || isAppAdmin(appId));
        allow create, delete: if isGlobalAdmin();
        allow update: if isGlobalAdmin() || (
          request.auth != null &&
          request.auth.uid == userId &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastSeen'])
        );
      }

      // Stations
      match /stations/{stationId} {
        allow read: if true;
        allow create, delete: if isAppAdmin(appId);
        allow update: if isAppAdmin(appId) || (
          // Allow incrementing likes
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes']) &&
          isIncrement('likes')
        );
      }

      // Events
      match /events/{eventId} {
        allow read: if true;
        allow write: if isAppAdmin(appId);
      }

      // Presence (Heartbeat)
      match /presence/{sessionId} {
        allow read: if true;
        allow write: if true; // Public write for heartbeat
      }

      // Anonymous Lichter-Pass analytics
      match /checkins/{checkinId} {
        allow create: if true;
        allow read, update, delete: if isAppAdmin(appId);
      }

      // Pseudonymous activity log. No contact, GPS or free-text fields.
      match /auditLogs/{logId} {
        allow create: if request.auth != null &&
          request.resource.data.keys().hasOnly(['eventType', 'actorId', 'actorRole', 'createdAt', 'details', 'appId']) &&
          request.resource.data.details.keys().hasOnly(['stationId', 'stationName', 'eventId', 'eventTitle', 'action', 'count', 'level', 'itemType']) &&
          (request.resource.data.actorRole == 'visitor' ||
            (request.resource.data.actorRole == 'admin' && isAppAdmin(appId))) &&
          request.resource.data.eventType is string &&
          request.resource.data.actorId is string;
        allow read, delete: if isAppAdmin(appId);
        allow update: if false;
      }
    }

    match /globalAdmins/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false;
    }

    // Config (Downloads)
    match /artifacts/{appId}/public/config {
      allow read: if true;
      allow write: if isAppAdmin(appId);
    }

    // Broadcast (Messages)
    match /artifacts/{appId}/public/broadcast {
      allow read: if true;
      allow write: if isAppAdmin(appId);
    }

    // Reports
    match /artifacts/{appId}/public/reports/{reportId} {
        // Allow all authenticated users (including anonymous auth) to create a report.
        allow create: if request.auth != null;
        allow read, update, delete: if isAppAdmin(appId);
    }
  }
}
