rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isGlobalAdmin() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/globalAdmins/$(request.auth.uid));
    }

    function isAppAdmin(appId) {
      return isGlobalAdmin() || (
        request.auth != null &&
        exists(/databases/$(database)/documents/artifacts/$(appId)/public/data/users/$(request.auth.uid))
      );
    }
    
    function isIncrement(field) {
      return request.resource.data[field] is int &&
        resource.data[field] is int &&
        request.resource.data[field] == resource.data[field] + 1 &&
        request.resource.data[field] <= 100000;
    }

    function isInitialCounter(field) {
      return !request.resource.data.keys().hasAny([field]) ||
        (request.resource.data[field] is int && request.resource.data[field] == 1);
    }

    function validStatsCreate() {
      return request.resource.data.keys().hasOnly([
          'count_bronze', 'count_silver', 'count_gold', 'count_diamond'
        ]) &&
        isInitialCounter('count_bronze') &&
        isInitialCounter('count_silver') &&
        isInitialCounter('count_gold') &&
        isInitialCounter('count_diamond');
    }

    function validStatsUpdate() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return changed.hasOnly([
          'count_bronze', 'count_silver', 'count_gold', 'count_diamond'
        ]) &&
        (!changed.hasAny(['count_bronze']) || isIncrement('count_bronze')) &&
        (!changed.hasAny(['count_silver']) || isIncrement('count_silver')) &&
        (!changed.hasAny(['count_gold']) || isIncrement('count_gold')) &&
        (!changed.hasAny(['count_diamond']) || isIncrement('count_diamond'));
    }

    function validPresence() {
      return request.auth != null &&
        request.resource.data.keys().hasOnly(['lastSeen']) &&
        request.resource.data.lastSeen == request.time;
    }

    function validCheckin(appId) {
      return request.auth != null &&
        request.resource.data.keys().hasOnly([
          'type', 'anonymousId', 'stationId', 'stationName', 'checkedAt',
          'dateKey', 'hour', 'passCountAfter', 'reachedLevel', 'source', 'appId'
        ]) &&
        request.resource.data.type == 'checkin' &&
        request.resource.data.appId == appId &&
        request.resource.data.anonymousId is string && request.resource.data.anonymousId.size() <= 64 &&
        request.resource.data.stationId is string && request.resource.data.stationId.size() <= 64 &&
        request.resource.data.stationName is string && request.resource.data.stationName.size() <= 250 &&
        request.resource.data.checkedAt is string && request.resource.data.checkedAt.size() <= 40 &&
        request.resource.data.dateKey is string && request.resource.data.dateKey.size() <= 16 &&
        request.resource.data.hour is int && request.resource.data.hour >= 0 && request.resource.data.hour <= 23 &&
        request.resource.data.passCountAfter is int && request.resource.data.passCountAfter >= 0 && request.resource.data.passCountAfter <= 500 &&
        request.resource.data.reachedLevel is string && request.resource.data.reachedLevel.size() <= 20 &&
        request.resource.data.source == 'lichterpass';
    }

    function validAuditLog(appId) {
      return request.auth != null &&
        request.resource.data.keys().hasOnly(['eventType', 'actorId', 'actorRole', 'createdAt', 'details', 'appId']) &&
        request.resource.data.keys().hasAll(['eventType', 'actorId', 'actorRole', 'createdAt', 'details', 'appId']) &&
        request.resource.data.details.keys().hasOnly(['stationId', 'stationName', 'eventId', 'eventTitle', 'action', 'count', 'level', 'itemType']) &&
        request.resource.data.appId == appId &&
        request.resource.data.eventType is string && request.resource.data.eventType.size() <= 48 &&
        request.resource.data.actorId is string && request.resource.data.actorId.size() <= 64 &&
        request.resource.data.createdAt is string && request.resource.data.createdAt.size() <= 40 &&
        (request.resource.data.actorRole == 'visitor' ||
          (request.resource.data.actorRole == 'admin' && isAppAdmin(appId)));
    }

    // Global Config
    match /global/config {
      allow read: if true;
      allow write: if isGlobalAdmin();
    }

    // Global Stats (Champions)
    match /global/stats {
      allow read: if true;
      allow create: if isGlobalAdmin() || validStatsCreate();
      allow update: if isGlobalAdmin() || validStatsUpdate();
    }

    // Artifacts (App Data)
    match /artifacts/{appId}/public/data {
      
      // Users (Admins)
      match /users/{userId} {
        allow read: if request.auth != null &&
          (request.auth.uid == userId || isAppAdmin(appId));
        allow create, delete: if isGlobalAdmin();
        allow update: if isGlobalAdmin() || (
          request.auth != null &&
          request.auth.uid == userId &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastSeen'])
        );
      }

      // Stations
      match /stations/{stationId} {
        allow read: if true;
        allow create, delete: if isAppAdmin(appId);
        allow update: if isAppAdmin(appId) || (
          // Allow incrementing likes
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes']) &&
          isIncrement('likes')
        );
      }

      // Events
      match /events/{eventId} {
        allow read: if true;
        allow write: if isAppAdmin(appId);
      }

      // Presence (Heartbeat)
      match /presence/{sessionId} {
        allow read: if true;
        allow create, update: if validPresence();
        allow delete: if request.auth != null;
      }

      // Anonymous Lichter-Pass analytics
      match /checkins/{checkinId} {
        allow create: if validCheckin(appId);
        allow read, update, delete: if isAppAdmin(appId);
      }

      // Pseudonymous activity log. No contact, GPS or free-text fields.
      match /auditLogs/{logId} {
        allow create: if validAuditLog(appId);
        allow read, delete: if isAppAdmin(appId);
        allow update: if false;
      }
    }

    match /globalAdmins/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false;
    }

    // Config (Downloads)
    match /artifacts/{appId}/public/config {
      allow read: if true;
      allow write: if isAppAdmin(appId);
    }

    // Broadcast (Messages)
    match /artifacts/{appId}/public/broadcast {
      allow read: if true;
      allow write: if isAppAdmin(appId);
    }

    // Reports
    match /artifacts/{appId}/public/reports/{reportId} {
        allow read, write: if isAppAdmin(appId);
    }
  }
}
