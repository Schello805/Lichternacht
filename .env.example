## SMTP config for bug report email relay (server-side).
# Lokaler Produktionsmodus: nur mit vorhandenen, geprüften Datenbanken aktivieren.
# Bestehende produktive systemd-Drop-ins beibehalten; nicht durch diese Vorlage ersetzen.
# LOCAL_DATABASE_ENABLED=false
# LOCAL_DATABASE_PATH=/var/www/html/Lichternacht/.private/local.sqlite3
## Copy to `.env` on the server and fill in values.
## Never commit `.env` (it's in .gitignore).
#
## Required:
# SMTP_HOST=smtp.example.com
# SMTP_USER=your-smtp-user
# SMTP_PASS=your-smtp-password
#
## Optional:
# SMTP_PORT=587
# SMTP_SSL=false
# FIREBASE_API_KEY=Firebase-Web-API-Key (optional; wird sonst aus config.js gelesen)
# FIREBASE_AUTH_REFERER=https://lichternacht-bechhofen.de/
#
## Bug report mail routing:
# BUGREPORT_TO=admin@schellenberger.biz
# BUGREPORT_FROM=admin@schellenberger.biz
#
## Admins, die Stationsbilder auf den eigenen Server laden dürfen:
# ADMIN_EMAILS=michael@schellenberger.biz
# Only enable this when Apache overwrites X-Forwarded-For with the actual client IP.
# TRUST_PROXY_HEADERS=false
# LOCAL_AUTH_ENABLED=false
# LOCAL_AUTH_PATH=/sicherer/pfad/.private/local-auth.sqlite3
# LOCAL_AUTH_ORIGIN=https://lichternacht-bechhofen.de
